+    // Upsample/downsample Conv2d of the resample block: runs every frame as a KD=1 conv3d
+    // (Pascal SIMT implicit-GEMM kernel). Input [W,H,C,T] has the same memory layout as [W,H,1,T*C]
+    // (no copy); weight [KW,KH,IC,OC] is viewed as [KW,KH,1,IC*OC]. No im2col buffer is created.
+    // Set SD_WAN_RESAMPLE_CONV3D=0 to fall back to the original conv2d path (A/B test).
+    // If the preconditions below are not met, Conv2d::forward is used.
+    class Conv2dKd1 : public Conv2d {
+    public:
+        using Conv2d::Conv2d;
+
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x) override {
+            static const bool disabled = []() {
+                const char* e = getenv("SD_WAN_RESAMPLE_CONV3D");
+                return e != nullptr && e[0] == '0';
+            }();
+            ggml_tensor* w = params["weight"];
+            if (disabled || !ctx->conv3d_direct_enabled || ctx->weight_adapter != nullptr ||
+                ctx->circular_x_enabled || ctx->circular_y_enabled || scale != 1.f ||
+                dilation.first != 1 || dilation.second != 1 ||
+                w == nullptr || (w->type != GGML_TYPE_F16 && w->type != GGML_TYPE_F32) ||
+                x->type != GGML_TYPE_F32 || x->ne[2] != in_channels) {
+                return Conv2d::forward(ctx, x);
+            }
+            ggml_context* g = ctx->ggml_ctx;
+            const int64_t T = x->ne[3];
+            ggml_tensor* x3 = ggml_reshape_4d(g, ggml_ext_cont(ctx, x), x->ne[0], x->ne[1], 1, in_channels * T);
+            ggml_tensor* w3 = ggml_reshape_4d(g, w, w->ne[0], w->ne[1], 1, in_channels * out_channels);
+            ggml_tensor* y  = ggml_conv_3d_direct(g, w3, x3,
+                                                  stride.second, stride.first, 1,
+                                                  padding.second, padding.first, 0,
+                                                  1, 1, 1,
+                                                  (int)in_channels, (int)T, (int)out_channels);
+            y = ggml_reshape_4d(g, y, y->ne[0], y->ne[1], out_channels, T);
+            if (bias) {
+                ggml_tensor* b = params["bias"];
+                y              = ggml_add_inplace(g, y, ggml_reshape_4d(g, b, 1, 1, b->ne[0], 1));
+            }
+            return y;
+        }
+    };
+
