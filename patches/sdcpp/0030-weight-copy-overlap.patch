+// SD_STAGING_POOL_MB (default 0 = off): keep up to this many MB of freed device staging buffers for reuse
+// instead of cudaFree + cudaMalloc per segment. See patch 0011 for the safety argument.
+static size_t staging_pool_cap_bytes() {
+    static const size_t cap = []() -> size_t {
+        const char* e = std::getenv("SD_STAGING_POOL_MB");
+        if (e == nullptr) {
+            return 0;
+        }
+        const long v = std::strtol(e, nullptr, 10);
+        return v > 0 ? (static_cast<size_t>(v) << 20) : 0;
+    }();
+    return cap;
+}
+
+// SD_STAGING_PREEVICT (default 0 = off; needs SD_STAGING_POOL_MB > 0): when no pooled buffer of the exact size is available for a new
+// staging allocation, first hand the already-finished (unpinned) staged blocks of earlier segments back to the pool, then look again.
+// See patch 0021.
+static bool staging_preevict_enabled() {
+    static const bool on = []() -> bool {
+        const char* e = std::getenv("SD_STAGING_PREEVICT");
+        return e != nullptr && std::strtol(e, nullptr, 10) > 0;
+    }();
+    return on;
+}
+static size_t g_staging_preevict_hits = 0;
+
+ggml_backend_buffer_t ModelManager::alloc_staging_tensors(ggml_context* ctx,
+                                                          ggml_backend_buffer_type_t buft,
+                                                          ggml_backend_t compute_backend) {
+    if (staging_pool_cap_bytes() == 0) {
+        return ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+    }
+    for (int pass = 0; pass < (staging_preevict_enabled() ? 2 : 1); ++pass) {
+        if (pass == 1) {
+            // no exact-size match yet: earlier segments' blocks that nobody pins any more are given back (they are the same blocks the
+            // capacity eviction would hand back later); their buffers land in the pool, then the search runs once more
+            release_compute_staging_blocks(false);
+        }
+        if (staging_pool_.empty()) {
+            continue;
+        }
+        const size_t need = ggml_backend_alloc_ctx_tensors_from_buft_size(ctx, buft);
+        for (auto it = staging_pool_.begin(); it != staging_pool_.end(); ++it) {
+            if (it->buft != buft || it->compute_backend != compute_backend || it->size != need) {
+                continue;
+            }
+            ggml_backend_buffer_t buffer = it->buffer;
+            staging_pool_.erase(it);
+            // cudaFree used to be an implicit device-wide barrier: every kernel that read this memory had finished.
+            // Keep that guarantee before the memory is handed to new tensors.
+            ggml_backend_synchronize(compute_backend);
+            // Same layout the stock allocator produces: tensors in context order, each padded to the alignment.
+            ggml_tallocr talloc = ggml_tallocr_new(buffer);
+            bool ok             = true;
+            for (ggml_tensor* t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+                if (ggml_tallocr_alloc(&talloc, t) != GGML_STATUS_SUCCESS) {
+                    ok = false;
+                    break;
+                }
+            }
+            if (!ok) {
+                ggml_backend_buffer_free(buffer);
+                return nullptr;
+            }
+            ++staging_pool_reuses_;
+            if (pass == 1) {
+                ++g_staging_preevict_hits;
+            }
+            return buffer;
+        }
+    }
+    ++staging_pool_fresh_;
+    return ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+}
+
+void ModelManager::release_staging_buffer(ggml_backend_buffer_t buffer, ggml_backend_t compute_backend) {
+    if (buffer == nullptr) {
+        return;
+    }
+    const size_t cap  = staging_pool_cap_bytes();
+    const size_t size = ggml_backend_buffer_get_size(buffer);
+    if (cap == 0 || size > cap || ggml_backend_buffer_is_host(buffer) || compute_backend == nullptr) {
+        ggml_backend_buffer_free(buffer);
+        return;
+    }
+    size_t total = size;
+    for (const auto& entry : staging_pool_) {
+        total += entry.size;
+    }
+    while (total > cap && !staging_pool_.empty()) {
+        total -= staging_pool_.front().size;
+        ggml_backend_buffer_free(staging_pool_.front().buffer);
+        staging_pool_.erase(staging_pool_.begin());
+    }
+    staging_pool_.push_back({ggml_backend_buffer_get_type(buffer), compute_backend, size, buffer});
+}
+
+void ModelManager::drain_staging_pool() {
+    for (auto& entry : staging_pool_) {
+        ggml_backend_buffer_free(entry.buffer);
+    }
+    staging_pool_.clear();
+}
+
+// SD_PREFETCH_THREAD (default 0 = off): issue the next segment's cudaMemcpyAsync calls from a worker thread.
+// The source is pageable (mmap) memory, for which cudaMemcpyAsync returns only after the driver has staged the bytes,
+// i.e. the calling thread is blocked for roughly size/bandwidth. Inline, that block sits in the compute callback BEFORE the
+// current segment's kernels are launched, so the GPU idles. On a worker thread the main thread launches the kernels at once.
+// See patch 0016 for the safety argument.
+static bool prefetch_thread_enabled() {
+    static const bool on = []() -> bool {
+        const char* e = std::getenv("SD_PREFETCH_THREAD");
+        return e != nullptr && std::strtol(e, nullptr, 10) > 0;
+    }();
+    return on;
+}
+
+// SD_STAGING_PINNED (default 0 = off; needs SD_PREFETCH_THREAD=1): send the weights through a small page-locked (pinned) ring buffer.
+// The worker thread memcpy's each mmap (pageable) tensor into the ring and calls cudaMemcpyAsync from the pinned ring, so the driver does
+// not stage pageable memory inside the call (that call blocks the caller and, measured with 0016, also stalls the main thread's kernel
+// launches). SD_STAGING_PINNED_MB (default 64) sizes the ring; a tensor larger than the ring, or any allocation failure, silently
+// uses the old path. Bytes copied are identical; only the copy route changes. See patch 0023.
+// SD_STAGING_VERIFY=N (default 0 = off, diagnostic only): after the next N prefetched blocks have finished copying, read every staged
+// host-sourced tensor back from the card and memcmp it with the source (mmap) bytes; one INFO line per block and one total line at release.
+// Slow (reads the whole block back), meant for short runs. Works with or without SD_STAGING_PINNED. See patch 0023.
+static long staging_verify_blocks() {
+    static const long n = []() -> long {
+        const char* e = std::getenv("SD_STAGING_VERIFY");
+        return e != nullptr ? std::strtol(e, nullptr, 10) : 0;
+    }();
+    return n;
+}
+static size_t g_ring_tensors = 0, g_ring_bytes = 0, g_fb_tensors = 0, g_fb_bytes = 0;  // ring vs fallback counters (0023)
+static bool g_warned_nothread = false, g_warned_big = false;
+static long g_verify_left = -1;  // -1 = not initialised
+static size_t g_verify_blocks = 0, g_verify_tensors = 0, g_verify_bad = 0;
+
+struct PinnedRing {
+    std::mutex mutex;
+    ggml_backend_buffer_t buffer = nullptr;
+    uint8_t* base                = nullptr;
+    size_t size                  = 0;
+    size_t offset                = 0;
+    ggml_backend_t last_backend  = nullptr;  // backend whose copies may still read the ring
+    bool failed                  = false;
+};
+
+static PinnedRing& pinned_ring() {
+    static PinnedRing ring;
+    return ring;
+}
+
+static size_t pinned_ring_bytes() {
+    static const size_t bytes = []() -> size_t {
+        const char* e = std::getenv("SD_STAGING_PINNED");
+        if (e == nullptr || std::strtol(e, nullptr, 10) <= 0) {
+            return 0;
+        }
+        long mb = 64;
+        if (const char* m = std::getenv("SD_STAGING_PINNED_MB")) {
+            mb = std::strtol(m, nullptr, 10);
+        }
+        return mb > 0 ? (static_cast<size_t>(mb) << 20) : 0;
+    }();
+    return bytes;
+}
+
+// caller holds ring.mutex; true when the ring is usable
+static bool pinned_ring_ensure(PinnedRing& ring, ggml_backend_t transfer_backend) {
+    if (ring.buffer != nullptr) {
+        return true;
+    }
+    const size_t bytes = pinned_ring_bytes();
+    if (bytes == 0 || ring.failed || transfer_backend == nullptr) {
+        return false;
+    }
+    ggml_backend_buffer_type_t buft = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(transfer_backend));
+    ggml_backend_buffer_t buffer    = buft != nullptr ? ggml_backend_buft_alloc_buffer(buft, bytes) : nullptr;
+    // ggml-cuda hands back a pageable buffer (not null) when cudaMallocHost fails: check the type, not just null.
+    if (buffer != nullptr && ggml_backend_buffer_get_type(buffer) != buft) {
+        LOG_WARN("SD_STAGING_PINNED: pinned host allocation of %zu MB failed (got a pageable buffer), ring disabled", bytes >> 20);
+        ggml_backend_buffer_free(buffer);
+        buffer = nullptr;
+    }
+    if (buffer == nullptr) {
+        LOG_WARN("SD_STAGING_PINNED: ring allocation failed, falling back to the pageable path");
+        ring.failed = true;
+        return false;
+    }
+    ring.buffer = buffer;
+    ring.base   = static_cast<uint8_t*>(ggml_backend_buffer_get_base(buffer));
+    ring.size   = bytes;
+    ring.offset = 0;
+    return true;
+}
+
+static void pinned_ring_release() {
+    PinnedRing& ring = pinned_ring();
+    std::lock_guard<std::mutex> lock(ring.mutex);
+    if (ring.buffer != nullptr) {
+        if (ring.last_backend != nullptr) {
+            ggml_backend_synchronize(ring.last_backend);
+        }
+        ggml_backend_buffer_free(ring.buffer);
+        ring.buffer = nullptr;
+        ring.base   = nullptr;
+        ring.size   = 0;
+        ring.offset = 0;
+    }
+    ring.last_backend = nullptr;
+}
 
